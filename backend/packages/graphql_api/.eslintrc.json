{
  "env": {
    "browser": true,
    "commonjs": true,
    "node": true
  },
  "extends": ["plugin:prettier/recommended"],
  "overrides": [
    {
      "files": ["*.mjs"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ],
  "parserOptions": {
    "ecmaVersion": 12
  },
  "rules": {
    "camelcase": [0],
    "consistent-return": [0],
    "object-curly-newline": [0],
    "no-console": [0],
    "no-plusplus": [0],
    "no-shadow": [0],
    "no-unused-vars": [2, { "argsIgnorePattern": "^_" }],
    "no-use-before-define": [0],
    "prefer-destructuring": [0]
  }
}
